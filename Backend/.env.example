# ---------------------------------------------------------------------------
# OctoGame AR / BarAR — Docker Compose settings
# Run from SonGoten/Backend: cp .env.example .env
# ---------------------------------------------------------------------------

# Host port published by compose (container always listens on 3501).
OCTOGAMEAR_HOST_PORT=3501

# Image tag for sungoten/barar. The Docker repository must be lowercase.
BARAR_TAG=latest
BARAR_VERSION=0.1.0

# Public URL prefix for the frontend and health endpoint.
OCTOGAMEAR_BASE_PATH=/octogame/barar

# --- Build-time frontend fetch (China acceleration) ------------------------
# Comma-separated accelerator prefixes, tried in order. The build falls back to
# direct GitHub after the list is exhausted. Set empty to use GitHub direct.
# For a Gitee mirror, set GIT_MIRROR= and REPO_URL=https://gitee.com/.../SonGoten.git
GIT_MIRROR=https://ghfast.top/,https://gh-proxy.com/,https://ghproxy.net/
REPO_URL=https://github.com/JHerculesqz/SonGoten.git
REPO_REF=master

# Base image (mirror it if Docker Hub is slow):
#   PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
PYTHON_IMAGE=python:3.12-slim

# uv is installed from PyPI at this exact version (no ghcr.io dependency).
UV_VERSION=0.13.1

# Python package index used to install uv and its dependencies during the
# image build. A domestic mirror accelerates both.
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Debian apt mirror for the frontend-fetch stage, e.g. mirrors.aliyun.com
# APT_MIRROR=mirrors.aliyun.com

# --- Static web runtime ----------------------------------------------------
OCTOGAMEAR_LOG_LEVEL=info

# --- BarStreet game --------------------------------------------------------
# Public prefix for the pixel street game, served by the same container.
OCTOGAMEAR_STREET_BASE_PATH=/octogame/barstreet

# Staff console PIN. CHANGE THIS before deploying to a real bar.
OCTOGAMEAR_STREET_STAFF_PIN=8888

# Shift-token signing secret. Leave empty to auto-generate and persist in
# SQLite; set an explicit value for multi-instance or reproducible deployments.
OCTOGAMEAR_STREET_SECRET=

# Minimum seconds between shift start and settlement. Keep 20 in production;
# set 0 only for local tests.
OCTOGAMEAR_STREET_MIN_SHIFT_SECONDS=20
